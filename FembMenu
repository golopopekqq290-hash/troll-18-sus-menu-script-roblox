							0
						)

					root.AssemblyLinearVelocity =
						Vector3.zero
				end
			)

		task.wait(1)

		if not running then
			return
		end

		if rig == "R6" then

			playAnimation(
				"148840371",
				3
			)

		else

			playAnimation(
				"5918726674",
				1
			)
		end
	end)
end

--========================================================
-- ACTION BUTTON CREATOR
--========================================================

local function createActionButton(
	name,
	callback
)

	local button =
		Instance.new("TextButton")

	button.Size =
		UDim2.new(
			1,
			0,
			0,
			40
		)

	button.BackgroundColor3 =
		BUTTON

	button.BorderSizePixel = 0
	button.AutoButtonColor = false

	button.Font =
		Enum.Font.GothamMedium

	button.Text = name

	button.TextSize = 12

	button.TextColor3 =
		Color3.fromRGB(
			250,
			232,
			246
		)

	button.Parent = Buttons

	local corner =
		Instance.new("UICorner")

	corner.CornerRadius =
		UDim.new(0, 12)

	corner.Parent = button

	actionButtons[name] =
		button

	button.MouseEnter:Connect(
		function()

			if currentAction ~= name then

				TweenService:Create(
					button,

					TweenInfo.new(0.12),

					{
						BackgroundColor3 =
							Color3.fromRGB(
								75,
								49,
								72
							)
					}
				):Play()
			end
		end
	)

	button.MouseLeave:Connect(
		function()

			if currentAction ~= name then

				TweenService:Create(
					button,

					TweenInfo.new(0.12),

					{
						BackgroundColor3 =
							BUTTON
					}
				):Play()
			end
		end
	)

	button.MouseButton1Click:Connect(
		function()

			if not selectedPlayer then

				Status.Text =
					"Choose a player first ♡"

				return
			end

			if not selectedPlayer.Parent then

				selectedPlayer = nil

				Status.Text =
					"Player left"

				return
			end

			if running
				and currentAction == name
			then

				stopEverything()

				Status.Text =
					"Stopped ♡"

				return
			end

			stopEverything()

			currentAction = name
			running = true

			TweenService:Create(
				button,

				TweenInfo.new(0.15),

				{
					BackgroundColor3 =
						BUTTON_ACTIVE
				}
			):Play()

			Status.Text =
				name
				.. " • "
				.. getRig()
				.. " • "
				.. selectedPlayer.DisplayName

			callback()
		end
	)
end

