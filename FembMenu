--========================================================
-- DRAGGING
--========================================================

local dragging = false
local dragStart = nil
local dragPosition = nil

Top.InputBegan:Connect(
	function(input)

		if input.UserInputType
			== Enum.UserInputType.MouseButton1
		then

			dragging = true

			dragStart =
				input.Position

			dragPosition =
				Main.Position
		end
	end
)

UIS.InputChanged:Connect(
	function(input)

		if dragging
			and input.UserInputType
				== Enum.UserInputType.MouseMovement
		then

			local delta =
				input.Position
				- dragStart

			Main.Position =
				UDim2.new(

					dragPosition.X.Scale,

					dragPosition.X.Offset
						+ delta.X,

					dragPosition.Y.Scale,

					dragPosition.Y.Offset
						+ delta.Y
				)
		end
	end
)

UIS.InputEnded:Connect(
	function(input)

		if input.UserInputType
			== Enum.UserInputType.MouseButton1
		then

			dragging = false
		end
	end
)

--========================================================
-- UI TRANSPARENCY
--========================================================

local function tweenContent(show)

	local textTransparency =
		show and 0 or 1

	local panelTransparency =
		show and 0 or 1

	local buttonTransparency =
		show and 0 or 1

	TweenService:Create(
		MainStroke,
		TWEEN_INFO,
		{
			Transparency =
				show and 0.35 or 1
		}
	):Play()

	TweenService:Create(
		Top,
		TWEEN_INFO,
		{
			BackgroundTransparency =
				panelTransparency
		}
	):Play()

	TweenService:Create(
		TopBottomFix,
		TWEEN_INFO,
		{
			BackgroundTransparency =
				panelTransparency
		}
	):Play()

	for _, label in ipairs({
		Title,
		Credit,
		RigLabel,
		PlayerTitle,
		SelectedLabel,
		ActionTitle,
		Status
	}) do

		TweenService:Create(
			label,
			TWEEN_INFO,
			{
				TextTransparency =
					textTransparency
			}
		):Play()
	end

	TweenService:Create(
		PlayerPanel,
		TWEEN_INFO,
		{
			BackgroundTransparency =
				panelTransparency
		}
	):Play()

	TweenService:Create(
		ActionPanel,
		TWEEN_INFO,
		{
			BackgroundTransparency =
				panelTransparency
		}
	):Play()

	TweenService:Create(
		Minimize,
		TWEEN_INFO,
		{
			BackgroundTransparency =
				buttonTransparency,

			TextTransparency =
				textTransparency
		}
	):Play()

	TweenService:Create(
		Close,
		TWEEN_INFO,
		{
			BackgroundTransparency =
				buttonTransparency,

			TextTransparency =
				textTransparency
		}
	):Play()

	for _, button in pairs(
		playerButtons
	) do

		TweenService:Create(
			button,
			TWEEN_INFO,
			{
				BackgroundTransparency =
					buttonTransparency,

				TextTransparency =
					textTransparency
			}
		):Play()
	end

	for _, button in pairs(
		actionButtons
	) do

		TweenService:Create(
			button,
			TWEEN_INFO,
			{
				BackgroundTransparency =
					buttonTransparency,

				TextTransparency =
					textTransparency
			}
		):Play()
	end
end

--========================================================
-- OPEN
--========================================================

local function openMenu()

	if closing then
		return
	end

	menuOpen = true

	Main.Visible = true

	if minimized then
		Main.Size =
			UDim2.fromOffset(
				530,
				58
			)
	else
		Main.Size =
			UDim2.fromOffset(
				530,
				350
			)
	end

	Main.BackgroundTransparency = 1

	local targetSize =
		minimized
			and MINIMIZED_SIZE
			or OPEN_SIZE

	local currentPosition =
		Main.Position

	Main.Position =
		UDim2.new(
			currentPosition.X.Scale,
			currentPosition.X.Offset,
			currentPosition.Y.Scale,
			currentPosition.Y.Offset + 24
		)

	TweenService:Create(
		Main,
		TWEEN_INFO,
		{
			Size = targetSize,

			Position =
				UDim2.new(
					currentPosition.X.Scale,
					currentPosition.X.Offset,
					currentPosition.Y.Scale,
					currentPosition.Y.Offset
				),

			BackgroundTransparency = 0
		}
	):Play()

	tweenContent(true)
end

--========================================================
-- HIDE
--========================================================

local function hideMenu()

	if closing
		or not menuOpen
	then
		return
	end

	menuOpen = false

	local position =
		Main.Position

	tweenContent(false)

	local tween =
		TweenService:Create(
			Main,

			TWEEN_INFO,

			{
				Size =
					UDim2.fromOffset(
						530,
						350
					),

				Position =
					UDim2.new(
						position.X.Scale,
						position.X.Offset,
						position.Y.Scale,
						position.Y.Offset + 24
					),

				BackgroundTransparency = 1
			}
		)

	tween:Play()

	task.delay(
		0.29,
		function()

			if not menuOpen
				and not closing
			then
				Main.Visible = false
			end
		end
	)
end

--========================================================
-- RIGHT SHIFT
--========================================================

UIS.InputBegan:Connect(
	function(input, processed)

		if processed then
			return
		end

		if input.KeyCode
			== Enum.KeyCode.RightShift
		then

			if menuOpen then
				hideMenu()
			else
				openMenu()
			end
		end
	end
)

