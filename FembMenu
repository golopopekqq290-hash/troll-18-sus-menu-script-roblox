--========================================================
-- CHARACTER
--========================================================

local function getCharacter()
	return LP.Character
end

local function getHumanoid()

	local character = getCharacter()

	if not character then
		return nil
	end

	return character:FindFirstChildOfClass("Humanoid")
end

local function getRoot()

	local character = getCharacter()

	if not character then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
end

local function getRig()

	local humanoid = getHumanoid()

	if humanoid
		and humanoid.RigType
			== Enum.HumanoidRigType.R6
	then
		return "R6"
	end

	return "R15"
end

--========================================================
-- TARGET
--========================================================

local function getTargetCharacter()

	if not selectedPlayer then
		return nil
	end

	return selectedPlayer.Character
end

local function getTargetRoot()

	local character = getTargetCharacter()

	if not character then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
end

local function getTargetTorso()

	local character = getTargetCharacter()

	if not character then
		return nil
	end

	return character:FindFirstChild("LowerTorso")
		or character:FindFirstChild("UpperTorso")
		or character:FindFirstChild("Torso")
end

--========================================================
-- ANIMATION
--========================================================

local function playAnimation(animationId, speed)

	local humanoid = getHumanoid()

	if not humanoid then
		return nil
	end

	local animator =
		humanoid:FindFirstChildOfClass("Animator")

	if not animator then

		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end

	local animation = Instance.new("Animation")

	animation.AnimationId =
		"rbxassetid://" .. tostring(animationId)

	local track =
		animator:LoadAnimation(animation)

	track:Play(0.15)

	track:AdjustSpeed(speed or 1)

	activeTrack = track

	return track
end

--========================================================
-- STOP EVERYTHING
--========================================================

local function stopEverything()

	running = false
	currentAction = nil

	if activeConnection then

		activeConnection:Disconnect()
		activeConnection = nil
	end

	if activeTween then

		pcall(function()
			activeTween:Cancel()
		end)

		activeTween = nil
	end

	if activeTrack then

		pcall(function()
			activeTrack:Stop(0.15)
		end)

		activeTrack = nil
	end

	if originalGravity ~= nil then

		workspace.Gravity = originalGravity
		originalGravity = nil
	end

	for _, button in pairs(actionButtons) do

		button.BackgroundColor3 = BUTTON
	end
end

