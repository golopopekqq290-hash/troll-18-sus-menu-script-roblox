--========================================================
-- REFRESH PLAYER LIST
--========================================================

local function refreshPlayers()

	for _, object in ipairs(
		PlayerList:GetChildren()
	) do

		if object:IsA("TextButton") then
			object:Destroy()
		end
	end

	playerButtons = {}

	for _, player in ipairs(
		Players:GetPlayers()
	) do

		if player ~= LP then

			local button =
				Instance.new("TextButton")

			button.Size =
				UDim2.new(
					1,
					-4,
					0,
					44
				)

			button.BackgroundColor3 =
				BUTTON

			button.BackgroundTransparency =
				0.05

			button.BorderSizePixel = 0

			button.AutoButtonColor = false

			button.Font =
				Enum.Font.GothamMedium

			button.Text =
				player.DisplayName
				.. "\n@"
				.. player.Name

			button.TextSize = 11

			button.TextColor3 =
				Color3.fromRGB(
					245,
					230,
					242
				)

			button.Parent = PlayerList

			local corner =
				Instance.new("UICorner")

			corner.CornerRadius =
				UDim.new(0, 11)

			corner.Parent = button

			playerButtons[player] = button

			button.MouseEnter:Connect(function()

				if selectedPlayer ~= player then

					TweenService:Create(
						button,
						TweenInfo.new(0.12),
						{
							BackgroundColor3 =
								Color3.fromRGB(
									72,
									48,
									70
								)
						}
					):Play()
				end
			end)

			button.MouseLeave:Connect(function()

				if selectedPlayer ~= player then

					TweenService:Create(
						button,
						TweenInfo.new(0.12),
						{
							BackgroundColor3 =
								BUTTON
						}
					):Play()
				end
			end)

			button.MouseButton1Click:Connect(
				function()

					selectedPlayer = player

					for plr, btn
						in pairs(playerButtons)
					do

						TweenService:Create(
							btn,
							TweenInfo.new(0.15),
							{
								BackgroundColor3 =
									plr
										== selectedPlayer
										and BUTTON_ACTIVE
										or BUTTON
							}
						):Play()
					end

					SelectedLabel.Text =
						"Target: "
						.. player.DisplayName

					Status.Text =
						"Ready • @"
						.. player.Name
				end
			)
		end
	end
end

Players.PlayerAdded:Connect(
	refreshPlayers
)

Players.PlayerRemoving:Connect(
	function(player)

		if selectedPlayer == player then

			stopEverything()

			selectedPlayer = nil

			SelectedLabel.Text =
				"Target: none"

			Status.Text =
				"Player left"
		end

		task.defer(refreshPlayers)
	end
)

refreshPlayers()

--========================================================
-- BANG V2
--========================================================

local function startBang()

	local rig = getRig()

	local root = getRoot()
	local targetRoot = getTargetRoot()

	if not root or not targetRoot then
		stopEverything()
		return
	end

	running = true

	if rig == "R6" then

		playAnimation(
			"189854234",
			1
		)

		activeConnection =
			RunService.Heartbeat:Connect(
				function()

					if not running then
						return
					end

					root = getRoot()
					targetRoot =
						getTargetRoot()

					if not root
						or not targetRoot
					then

						stopEverything()
						return
					end

					local targetCFrame =
						targetRoot.CFrame

					local followCFrame =
						targetCFrame
						* CFrame.new(
							0,
							0,
							1.2
						)

					root.CFrame =
						CFrame.new(
							followCFrame.Position
						)
						* CFrame.Angles(
							0,
							math.atan2(
								-targetCFrame.LookVector.X,
								-targetCFrame.LookVector.Z
							),
							0
						)
				end
			)

	else

		playAnimation(
			"10714068222",
			2
		)

		task.spawn(function()

			while running
				and currentAction
					== "Bang V2"
			do

				root = getRoot()
				targetRoot =
					getTargetRoot()

				if not root
					or not targetRoot
				then
					stopEverything()
					break
				end

				activeTween =
					TweenService:Create(
						root,

						TweenInfo.new(
							0.2,
							Enum.EasingStyle.Linear
						),

						{
							CFrame =
								targetRoot.CFrame
								* CFrame.new(
									0,
									0,
									1
								)
						}
					)

				activeTween:Play()
				activeTween.Completed:Wait()

				if not running then
					break
				end

				targetRoot =
					getTargetRoot()

				if not targetRoot then
					break
				end

				activeTween =
					TweenService:Create(
						root,

						TweenInfo.new(
							0.2,
							Enum.EasingStyle.Linear
						),

						{
							CFrame =
								targetRoot.CFrame
								* CFrame.new(
									0,
									0,
									2.5
								)
						}
					)

				activeTween:Play()
				activeTween.Completed:Wait()
			end
		end)
	end
end

